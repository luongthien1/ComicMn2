DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=comic_manager

# Chat: "gemini" hoặc "ollama"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (embedding + chat/kiểm mâu thuẫn/đánh giá).
# Endpoint/model có thể ghi đè ở trang Cài đặt; token chỉ đặt ở đây.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TOKEN=
OLLAMA_MODEL=qwen3.5:latest
EMBED_MODEL=bge-m3

# Neo4j — đồ thị truyện. Để trống thì chat vẫn chạy, chỉ mất phần tra cứu truyện.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Giới hạn upload ảnh (MB)
MAX_UPLOAD_MB=10
