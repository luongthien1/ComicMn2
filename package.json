{
  "name": "comicmn2",
  "version": "1.0.0",
  "private": true,
  "description": "ComicMn2 - app viet truyen (FastAPI + React)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luongthien1/ComicMn2.git"
  },
  "scripts": {
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn main:app --reload --host 127.0.0.1 --port 8010",
    "frontend": "npm run dev --prefix frontend",
    "test": "cd backend && .venv\\Scripts\\python -m pytest -q",
    "dev": "concurrently -n api,web -c blue,green \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
